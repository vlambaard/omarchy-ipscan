[Desktop Entry]
Version=1.0
Type=Application
Name=IP Scanner
GenericName=Network Scanner
Comment=Sweep the local subnet and browse live hosts
# @EXEC@ is filled in by install.sh: on Omarchy it becomes omarchy-launch-tui,
# the same launcher the Hyprland keybind uses, so both routes produce an
# identical window (app-id org.omarchy.omarchy-ipscan) that the float/size rule
# in hyprland.lua targets. Elsewhere it falls back to a plain terminal.
Exec=@EXEC@
Terminal=false
Icon=network-workgroup
Categories=Network;ConsoleOnly;
Keywords=network;scan;ip;lan;subnet;hosts;nmap;arp;discovery;
StartupNotify=true
